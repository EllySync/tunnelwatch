# ===========================================
# TunnelWatch Norway - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
POSTGRES_USER=tunnelwatch
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=tunnelwatch

# -------------------------------------------
# Redis (Task Queue)
# -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------------------------------
# Signal Notifications
# -------------------------------------------
# Your Signal phone number (with country code)
SIGNAL_NUMBER=+47XXXXXXXXX
SIGNAL_API_URL=http://signal-api:8080

# -------------------------------------------
# Vegvesen API
# -------------------------------------------
# Open API - no authentication required
VEGVESEN_API_URL=https://fjelloverganger-backend.atlas.vegvesen.no/v1/tunneler

# -------------------------------------------
# Monitoring Settings
# -------------------------------------------
# How often to poll for status changes (seconds)
POLL_INTERVAL=60

# -------------------------------------------
# Backup (Optional)
# -------------------------------------------
NAS_BACKUP_PATH=/mnt/nas/tunnelwatch-backups
BACKUP_RETENTION_DAYS=30

# -------------------------------------------
# Application
# -------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Oslo
